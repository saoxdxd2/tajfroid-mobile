{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/((?!router).*)", "destination": "/api/router?__route=$1" },
    { "source": "/((?!api/)[^.]*)", "destination": "/index.html" }
  ]
}
